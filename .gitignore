# Hugo generated files
/public/
/resources/_gen/
/assets/jsconfig.json
hugo_stats.json

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Dependencies
node_modules/

# Python 字节码：scripts/ 下多个工具用 python 直接跑，会在同目录生成 __pycache__。
# 不忽略的话 `git add scripts/` 会把 .pyc 一起入库（AGENTS.md 已为 public/、
# resources/_gen/、.superpowers/ 写了同类规则，这里补齐）。
__pycache__/
*.pyc

# Temporary files
*.swp
*.swo
*~

# Local hugo
/.hugo_build.lock

# superpowers 技能的工作区（实施计划执行过程中的台账、任务简报、评审包）。
# 过程性 scratch，不属于站点产物；最终记录落在 git 历史里。
/.superpowers/

# Kilo agent 的本地配置与状态，属过程性文件，不入库
/.kilo/

# Blowfish 主题：仓库只保留站点构建所需的文件
# 示例站（约 119 MB）与主题宣传图（约 18 MB）不参与构建，已从工作区删除；
# 规则保留作为保险，避免日后重新解压主题时把这 137 MB 误入库
/themes/blowfish/exampleSite/
/themes/blowfish/images/
